@inproceedings{TSPLibBench,
author = {Tosoni, Deniz and Galli, Christopher and Hanne, Thomas and Dornberger, Rolf},
title = {Benchmarking Metaheuristic Optimization Algorithms on Travelling Salesman Problems},
